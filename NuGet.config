<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Pins package restore to nuget.org for everyone who clones this repository.

    Without the <clear /> below, NuGet inherits every feed configured on the
    machine — a private corporate feed, a stale local folder, an internal mirror.
    Any one of those that is unreachable or needs credentials fails the restore
    for all packages, including for projects with no package references at all,
    because the vulnerability audit queries the same source list. The failure
    then looks like a problem with this code, which it is not.

    Pinning the sources here means "git clone && dotnet build" behaves the same
    on a reviewer's machine as it does on mine and as it does in CI.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Machine-level mappings would otherwise route packages to feeds cleared above. -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <disabledPackageSources>
    <clear />
  </disabledPackageSources>

</configuration>
